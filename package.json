{
  "name": "corrigenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . && tsc --noEmit && PATH=\"$PWD/.venv/bin:$PATH\" python3 scripts/contracts.py lint",
    "test": "vitest run && PATH=\"$PWD/.venv/bin:$PATH\" python3 -m pytest tests/direct tests/probes -q",
    "test:network": "node --env-file=.env --import=tsx scripts/network.ts",
    "db:migrate": "node --env-file=.env --import=tsx scripts/migrate.ts",
    "worker": "node --env-file=.env --import=tsx scripts/worker.ts",
    "index:rebuild": "node --env-file=.env --import=tsx scripts/rebuild.ts",
    "deploy:contracts": "node --env-file=.env --import=tsx scripts/deploy.ts",
    "deploy:consumers": "node --env-file=.env --import=tsx scripts/network.ts --deploy-only",
    "activate:network": "node --env-file=.env --import=tsx scripts/activate-network.ts",
    "migrate:adapters": "node --env-file=.env --import=tsx scripts/migrate-adapters.ts",
    "setup": "bash scripts/setup.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:restoration": "node --env-file=.env --import=tsx scripts/restoration.ts",
    "test:security": "node --env-file=.env --import=tsx scripts/security-network.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "@neondatabase/serverless": "1.0.2",
    "@privy-io/node": "0.39.0",
    "@privy-io/react-auth": "3.51.3",
    "@solana-program/system": "0.10.0",
    "diff": "8.0.2",
    "genlayer-js": "1.1.8",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "undici": "6.29.1",
    "viem": "2.57.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/diff": "7.0.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.29",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "ws": "8.22.2",
    "decode-uri-component": "0.5.1",
    "postcss": "8.5.32",
    "abitype": "1.2.3"
  }
}
