{
  "name": "corrigenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.18" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . && tsc --noEmit && python3 scripts/contracts.py lint",
    "test": "vitest run && python3 -m pytest tests/direct tests/probes -q",
    "test:network": "node --env-file=.env --import=tsx scripts/network.ts",
    "db:migrate": "node --env-file=.env --import=tsx scripts/migrate.ts",
    "worker": "node --env-file=.env --import=tsx scripts/worker.ts",
    "index:rebuild": "node --env-file=.env --import=tsx scripts/rebuild.ts",
    "deploy:contracts": "node --env-file=.env --import=tsx scripts/deploy.ts",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "next": "15.5.12",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "@privy-io/react-auth": "3.51.3",
    "@privy-io/server-auth": "1.32.5",
    "@neondatabase/serverless": "1.0.2",
    "genlayer-js": "1.1.8",
    "viem": "2.48.4",
    "zod": "3.25.76",
    "lucide-react": "0.577.0",
    "diff": "8.0.2",
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.12",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/diff": "7.0.2",
    "vitest": "3.2.4",
    "@playwright/test": "1.58.2"
  }
}
